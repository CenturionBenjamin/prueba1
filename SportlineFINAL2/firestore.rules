rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // El catálogo se puede consultar públicamente.
    // Los cambios de stock requieren una cuenta y solo permiten reducirlo.
    match /productos/{productoId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && (resource.data.stock is int || resource.data.stock is float)
        && request.resource.data.stock < resource.data.stock;
    }

    // El formulario puede crear consultas, pero ningún visitante puede leerlas
    // ni modificarlas desde la aplicación pública.
    match /consultas/{consultaId} {
      allow create: if request.resource.data.keys().hasAll(['nombre', 'correo', 'telefono', 'mensaje', 'fecha'])
        && request.resource.data.keys().hasOnly(['nombre', 'correo', 'telefono', 'mensaje', 'fecha'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 80
        && request.resource.data.correo is string
        && request.resource.data.correo.size() >= 5
        && request.resource.data.correo.size() <= 120
        && request.resource.data.correo.matches('.*@.*')
        && request.resource.data.telefono is string
        && request.resource.data.telefono.size() <= 30
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() >= 10
        && request.resource.data.mensaje.size() <= 1000
        && request.resource.data.fecha == request.time;
      allow read, update, delete: if false;
    }
  }
}
